# Claves de Groq (Llama 3.3 70B) para el asistente IA (/api/chat)
# Puedes pasar múltiples claves separadas por coma para rotación automática Round-Robin
GROQ_KEYS=gsk_tu_clave_aqui,gsk_tu_clave_secundaria_aqui

